# ===== Node / pnpm =====
node_modules/
dist/
dist-ssr/
*.local

# ===== Vite =====
.vite/

# ===== Python =====
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# NOTE: .python-version is intentionally NOT ignored — it pins the Python
# interpreter version (3.13) for anyone cloning the repo.

# ===== PyInstaller =====
# *.spec catches main-x86_64-pc-windows-msvc.spec generated at the root
*.spec
build/

# ===== Tauri / Rust =====
# src-tauri has its own .gitignore (Cargo-generated), but these patterns
# protect against accidental build artifacts leaking into git if that file
# is ever removed or renamed.
src-tauri/target/
src-tauri/gen/
src-tauri/bin/
src-tauri/.cache/

# ===== Local database (SQLite) =====
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ===== Secrets / local env =====
.env
.env.local
.env.*.local

# ===== Logs =====
*.log
logs/

# ===== OS / IDE =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Optional: uncomment if you don't want to share VS Code config =====
# .vscode/